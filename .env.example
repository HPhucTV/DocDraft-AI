# ==============================================================================
# DOCDRAFT AI — MÔI TRƯỜNG CẤU HÌNH HỆ THỐNG (.env.example)
# Sao chép tệp này thành .env.local để sử dụng trong quá trình phát triển
# ==============================================================================

# --- 1. CƠ SỞ DỮ LIỆU POSTGRESQL (SUPABASE) ---
# Connection pooling URL (PgBouncer cổng 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL dùng cho Prisma migrations (Cổng 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- 2. XÁC THỰC & BẢO MẬT (NEXTAUTH.JS V5) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-random-key-generate-with-openssl-rand-base64-32"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- 3. MICROSERVICE DOCUMENT SERVICE (FASTAPI DOCKER) ---
DOCUMENT_SERVICE_URL="http://localhost:8000"
INTERNAL_SECRET="docdraft-internal-microservice-shared-secret-key-2026"

# --- 4. CLOUDFLARE R2 FILE STORAGE (ADR-007) ---
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="docdraft-storage"
CLOUDFLARE_R2_PUBLIC_URL="https://storage.docdraft.vn"

# --- 5. AI DEFAULT GATEWAY (OPTIONAL / BYOK FALLBACK) ---
# Người dùng có thể tự nhập API key cá nhân (BYOK) qua UI
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"
